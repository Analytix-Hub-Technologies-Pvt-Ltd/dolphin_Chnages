# ========================
# Database Configuration (Remote Local Dev)
# ========================
DB_HOST=db.analytixhub.ai
DB_PORT=5432
DB_NAME=marine_db
DB_USER=AH-User
DB_PASSWORD=AH-Users@123

# ========================
# OpenAI Configuration
# ========================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0

# ========================
# Application Settings
# ========================
APP_ENV=development
LOG_LEVEL=INFO
FAISS_INDEX_PATH=./storage/faiss_index
DEBUG_MODE=false

# External APIs (Parth)
EXTERNAL_API_KEY=CDDDCD43BC944F2AA5DC501FB2CDE136
EXTERNAL_API_BASE_URL=https://ai.marinerskills.com/aidata
AUTH_API_BASE_URL=https://cms.marinerskills.com/api/DolphinLogin
IMAGE_BASE_URL=http://localhost:8000

# SECURITY
BACKEND_CORS_ORIGINS=http://localhost:8000
FRONTEND_HOST=http://localhost:3000

# RATE LIMITING
ENABLE_RATE_LIMITING=True
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=60/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_STRATEGY=fixed-window

UI_DIRECTORY=dolphin_ui/build
