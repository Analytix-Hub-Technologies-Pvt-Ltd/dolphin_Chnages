# ========================
# Database Configuration
# ========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marine
DB_USER=postgres
DB_PASSWORD=postgres@123

# ========================
# OpenAI Configuration
# ========================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo
OPENAI_TEMPERATURE=0.0

# ========================
# Application Settings
# ========================
APP_ENV=development
LOG_LEVEL=INFO
FAISS_INDEX_PATH=./storage/faiss_index
DEBUG_MODE=false

EXTERNAL_API_KEY=external_api_key
EXTERNAL_API_BASE_URL=external_api_url
IMAGE_BASE_URL=http://localhost:8000

# SECURITY
BACKEND_CORS_ORIGINS=http://locahost:8000
FRONTEND_HOST=http://locahost:3000

# RATE LIMITING
ENABLE_RATE_LIMITING=True
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=60/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1
RATE_LIMIT_STRATEGY=fixed-window

UI_DIRECTORY=ui

# FORGOT PASSWORD & MAIL SETTINGS
FORGOT_PASSWORD_API_URL=
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_email_password
MAIL_FROM=your_email@domain.com
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_SSL_TLS=False
MAIL_STARTTLS=True

# ========================
# Voice Mode (Local STT & TTS)
# ========================
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_MODEL_PATH=./storage/piper_models/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=./storage/piper_models/en_US-lessac-medium.onnx.json
# Length scale controls speech speed: >1.0 is slower, <1.0 is faster. 1.12 produces ~130-155 WPM.
PIPER_LENGTH_SCALE=1.12
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8

